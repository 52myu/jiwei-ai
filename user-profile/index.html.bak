    <!-- 首页 Hero 区域 -->
    <section id="home" class="hero">
        <div class="hero-container">
            <div class="hero-content">
                <h1 class="hero-greeting">你好，我是 <span class="highlight">Ji Ji</span></h1>
                <h2 class="hero-title">全栈开发工程师</h2>
                <p class="hero-description">
                    10年+前端开发经验，专注于构建高性能、用户体验优秀的Web应用
                </p>
                <div class="hero-buttons">
                    <a href="#projects" class="btn btn-primary">查看我的项目</a>
                    <a href="#contact" class="btn btn-secondary">联系我</a>
                </div>
            </div>
            <div class="hero-image">
                <div class="hero-avatar">
                    <img src="images/avatar-circle.jpg" style="width: 100%;" alt="Ji Ji 头像" />
                </div>
            </div>
        </div>
        <div class="scroll-indicator">
            <span>向下滚动</span>
            <div class="scroll-arrow"></div>
        </div>
    </section>

    <!-- 关于我 -->
    <section id="about" class="about">
        <div class="container">
            <h2 class="section-title">关于我</h2>
            <div class="about-content">
                <div class="about-text">
                    <p class="about-intro">
                        拥有10年以上前端开发经验的专业工程师，熟悉 Vue / React / uni-app / Node.js / Flutter 等技术体系。
                    </p>
                    <p class="about-detail">
                        具备从需求分析到架构设计、从开发上线到优化迭代的完整项目经验，能够独立负责复杂系统开发。
                        在医疗系统、企业中后台、工具型产品等多个领域有实际落地经验。
                    </p>
                    <div class="about-highlights">
                        <div class="highlight-item">
                            <div class="highlight-number">10+</div>
                            <div class="highlight-label">年经验</div>
                        </div>
                        <div class="highlight-item">
                            <div class="highlight-number">20+</div>
                            <div class="highlight-label">项目经验</div>
                        </div>
                        <div class="highlight-item">
                            <div class="highlight-number">5+</div>
                            <div class="highlight-label">技术领域</div>
                        </div>
                    </div>
                </div>
                <div class="about-skills">
                    <h3>核心技能</h3>
                    <div class="skills-grid">
                        <div class="skill-category">
                            <h4>前端开发</h4>
                            <div class="skill-tags">
                                <span class="skill-tag">Vue2/3</span>
                                <span class="skill-tag">React</span>
                                <span class="skill-tag">uni-app</span>
                                <span class="skill-tag">React Native</span>
                                <span class="skill-tag">Flutter</span>
                            </div>
                        </div>
                        <div class="skill-category">
                            <h4>工程化</h4>
                            <div class="skill-tags">
                                <span class="skill-tag">Webpack</span>
                                <span class="skill-tag">Vite</span>
                                <span class="skill-tag">组件库建设</span>
                                <span class="skill-tag">分包优化</span>
                            </div>
                        </div>
                        <div class="skill-category">
                            <h4>数据与通信</h4>
                            <div class="skill-tags">
                                <span class="skill-tag">WebSocket</span>
                                <span class="skill-tag">ECharts</span>
                                <span class="skill-tag">文件上传</span>
                            </div>
                        </div>
                        <div class="skill-category">
                            <h4>后端与其他</h4>
                            <div class="skill-tags">
                                <span class="skill-tag">Node.js</span>
                                <span class="skill-tag">MongoDB</span>
                                <span class="skill-tag">Three.js</span>
                                <span class="skill-tag">WebRTC</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 工作经历 -->
    <section id="experience" class="experience">
        <div class="container">
            <h2 class="section-title">工作经历</h2>
            <div class="timeline">
                <div class="timeline-item">
                    <div class="timeline-marker"></div>
                    <div class="timeline-content">
                        <div class="timeline-header">
                            <h3 class="timeline-title">企业系统（EAM / CMS / 工单 / 行政门户）</h3>
                            <span class="timeline-date">2025.10 – 至今</span>
                        </div>
                        <p class="timeline-role">前端 / 全栈开发工程师</p>
                        <ul class="timeline-achievements">
                            <li>2周内完成 Flutter App → H5 重构，覆盖全部核心功能</li>
                            <li>独立开发行政门户系统（H5 + Web管理端）并上线</li>
                            <li>深度参与工单系统全流程开发，向全栈 + AI方向拓展</li>
                            <li>负责EAM设备管理系统的持续维护与优化</li>
                        </ul>
                        <div class="timeline-tech">
                            <span class="tech-tag">Vue3</span>
                            <span class="tech-tag">状态管理</span>
                            <span class="tech-tag">跨端适配</span>
                        </div>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="timeline-marker"></div>
                    <div class="timeline-content">
                        <div class="timeline-header">
                            <h3 class="timeline-title">个人项目（小黄历 App / 码兔云打印平台）</h3>
                            <span class="timeline-date">2024.11 – 2025.10</span>
                        </div>
                        <p class="timeline-role">全栈开发工程师</p>
                        <ul class="timeline-achievements">
                            <li>从0到1完成小黄历App开发与上线（黄历/八字排盘/节气/经方知识库）</li>
                            <li>主导码兔云打印平台远程打印+快递履约系统设计与开发</li>
                            <li>实现证件照自动处理（裁剪/换背景）功能</li>
                            <li>小程序分包优化，显著提升加载速度</li>
                        </ul>
                        <div class="timeline-tech">
                            <span class="tech-tag">uni-app</span>
                            <span class="tech-tag">uView</span>
                            <span class="tech-tag">Node.js</span>
                        </div>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="timeline-marker"></div>
                    <div class="timeline-content">
                        <div class="timeline-header">
                            <h3 class="timeline-title">智能重症管理系统</h3>
                            <span class="timeline-date">2021.12 – 2024.11</span>
                        </div>
                        <p class="timeline-role">前端核心开发</p>
                        <ul class="timeline-achievements">
                            <li>ICU全流程系统开发：入科/出科/在科管理</li>
                            <li>医嘱/护理/设备绑定功能开发</li>
                            <li>基于RuoYi-Vue构建中后台系统</li>
                            <li>WebSocket实时数据通知系统</li>
                            <li>表格性能优化（类Excel能力实现）</li>
                        </ul>
                        <div class="timeline-tech">
                            <span class="tech-tag">Vue2</span>
                            <span class="tech-tag">WebSocket</span>
                            <span class="tech-tag">ECharts</span>
                        </div>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="timeline-marker"></div>
                    <div class="timeline-content">
                        <div class="timeline-header">
                            <h3 class="timeline-title">医疗相关系统（多个）</h3>
                            <span class="timeline-date">2018.07 – 2024.11</span>
                        </div>
                        <p class="timeline-role">前端负责人</p>
                        <ul class="timeline-achievements">
                            <li>医生辅助平台、围术期核查系统、交班系统开发</li>
                            <li>多媒体系统（视频/直播/三维模型）开发</li>
                            <li>实时通信系统（WebSocket）开发</li>
                            <li>React组件库建设与维护</li>
                        </ul>
                        <div class="timeline-tech">
                            <span class="tech-tag">React</span>
                            <span class="tech-tag">WebRTC</span>
                            <span class="tech-tag">Three.js</span>
                        </div>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="timeline-marker"></div>
                    <div class="timeline-content">
                        <div class="timeline-header">
                            <h3 class="timeline-title">一步购车</h3>
                            <span class="timeline-date">2017.06 – 2018.06</span>
                        </div>
                        <p class="timeline-role">React Native开发</p>
                        <ul class="timeline-achievements">
                            <li>开发跨端金融类App</li>
                            <li>自建热更新服务（Node + MongoDB）</li>
                        </ul>
                        <div class="timeline-tech">
                            <span class="tech-tag">React Native</span>
                            <span class="tech-tag">Node.js</span>
                            <span class="tech-tag">MongoDB</span>
                        </div>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="timeline-marker"></div>
                    <div class="timeline-content">
                        <div class="timeline-header">
                            <h3 class="timeline-title">派派猪理财</h3>
                            <span class="timeline-date">2014.07 – 2017.06</span>
                        </div>
                        <p class="timeline-role">全栈开发工程师</p>
                        <ul class="timeline-achievements">
                            <li>PC + H5 + App 全端开发</li>
                            <li>独立完成RN App上架流程</li>
                            <li>多渠道打包 + 热更新体系搭建</li>
                        </ul>
                        <div class="timeline-tech">
                            <span class="tech-tag">React</span>
                            <span class="tech-tag">H5</span>
                            <span class="tech-tag">App开发</span>
